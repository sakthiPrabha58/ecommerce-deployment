pipeline {
    agent any

    environment {
        NEXUS_REGISTRY      = "<NEXUS_PUBLIC_IP>:8081/repository/docker-hosted"
        SONARQUBE_SERVER    = "sonarqube-server"          // name configured in Jenkins > Manage Jenkins > System
        EKS_CLUSTER_NAME    = "cloudforge-eks"
        AWS_REGION          = "ap-south-1"
        IMAGE_TAG           = "${env.BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/<your-username>/cloudforge.git'
            }
        }

        stage('Backend: Unit Tests') {
            steps {
                dir('app/backend') {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install -r requirements.txt pytest
                        pytest --junitxml=results.xml
                    '''
                }
            }
            post {
                always {
                    junit 'app/backend/results.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${SONARQUBE_SERVER}") {
                    sh '''
                        sonar-scanner \
                          -Dsonar.projectKey=cloudforge \
                          -Dsonar.sources=app \
                          -Dsonar.python.version=3.12
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                sh """
                    docker build -t ${NEXUS_REGISTRY}/cloudforge-backend:${IMAGE_TAG} ./app/backend
                    docker build -t ${NEXUS_REGISTRY}/cloudforge-frontend:${IMAGE_TAG} ./app/frontend
                """
            }
        }

        stage('Push Images to Nexus') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'nexus-creds', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                    sh """
                        echo "\$NEXUS_PASS" | docker login ${NEXUS_REGISTRY} -u "\$NEXUS_USER" --password-stdin
                        docker push ${NEXUS_REGISTRY}/cloudforge-backend:${IMAGE_TAG}
                        docker push ${NEXUS_REGISTRY}/cloudforge-frontend:${IMAGE_TAG}
                    """
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh """
                    aws eks update-kubeconfig --name ${EKS_CLUSTER_NAME} --region ${AWS_REGION}

                    sed -i 's|<NEXUS_REGISTRY>/cloudforge-backend:latest|${NEXUS_REGISTRY}/cloudforge-backend:${IMAGE_TAG}|' k8s/backend-deployment.yaml
                    sed -i 's|<NEXUS_REGISTRY>/cloudforge-frontend:latest|${NEXUS_REGISTRY}/cloudforge-frontend:${IMAGE_TAG}|' k8s/frontend-deployment.yaml

                    kubectl apply -f k8s/namespace.yaml
                    kubectl apply -f k8s/backend-deployment.yaml
                    kubectl apply -f k8s/backend-service.yaml
                    kubectl apply -f k8s/frontend-deployment.yaml
                    kubectl apply -f k8s/frontend-service.yaml
                    kubectl apply -f k8s/ingress.yaml
                    kubectl apply -f k8s/hpa.yaml

                    kubectl rollout status deployment/backend -n cloudforge
                    kubectl rollout status deployment/frontend -n cloudforge
                """
            }
        }
    }

    post {
        success {
            echo "✅ CloudForge deployed successfully — build #${IMAGE_TAG}"
        }
        failure {
            echo "❌ Pipeline failed — check logs above"
        }
    }
}
